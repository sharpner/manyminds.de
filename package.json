{
  "name": "manyminds-de",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx scripts/dev.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs && npm run test:runtime",
    "test:runtime": "tsc -p tsconfig.runtime.json && node --test tests/runtime.test.cjs",
    "check": "tsc --noEmit && node --check script.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "resend": "^6.37.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  }
}
